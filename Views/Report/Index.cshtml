@{
    ViewData["Title"] = "報表列表";
}

<div class="target-report-main">
    <div class="target-report-body">
        <!-- 篩選器 -->
        <div class="target-report-row">
            <div class="target-report-row-label"><label>檢測項目</label></div>
            <select id="testItemSelect">
                <option value="">請選擇</option>
                <!-- AJAX 載入選項 -->
            </select>
        </div>

        <div class="target-report-row">
            <div class="target-report-row-label"><label>追蹤範圍</label></div>
            <input type="date" id="dateFrom"> ～ <input type="date" id="dateTo">
        </div>

        <div class="target-report-row">
            <div class="target-report-row-label"><label>案件狀態</label></div>
            <div class="target-report-input">
                <div><input type="checkbox" name="notifyStatus" value="待通知"><label>待通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="待追蹤"><label>待追蹤</label></div>
                <div><input type="checkbox" name="notifyStatus" value="已通知"><label>已通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="已追蹤"><label>已追蹤</label></div>
                <div><input type="checkbox" name="notifyStatus" value="不需通知"><label>不需通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="不需追蹤"><label>不需追蹤</label></div>
            </div>
        </div>

        <div class="target-report-row">
            <div class="target-report-row-label"><label>關鍵字</label></div>
            <div class="target-report-input">
                <input type="text" id="keyword" placeholder="輸入姓名/檢體編號...">
                <button id="exportExcel" class="btn btn-success">匯出Excel檔案</button>
            </div>
        </div>

        <!-- 報表列表 -->
        <div style="height: 530px;">

        <table class="table" style="margin-top: 20px;">
            <thead>
                <tr>
                    <th>序號</th>
                    <th>檢體編號</th>
                    <th>客戶姓名</th>
                    <th>檢測項目</th>
                    <th>採檢日期</th>
                    <th>報告日期</th>
                    <th>送檢院所</th>
                    <th>送檢醫師</th>
                    <th>通知狀態</th>
                    <th>追蹤狀態</th>
                    <th>編輯</th>
                    <th>檢視</th>
                </tr>
            </thead>
            <tbody id="reportTableBody">
                <!-- JS 動態生成 -->
            </tbody>
        </table>
        </div>

        <!-- 分頁 -->
        <div id="pagination" style="margin-top: 10px;"></div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#exportExcel').on('click', function () {
            // 1. 蒐集篩選條件
           // 讀取 checkbox 勾選值
            const notifyStatusFilters = $('input[name="notifyStatus"]:checked')
                .map(function () { return $(this).val(); })
                .get();

            const trackStatusFilters = $('input[name="trackStatus"]:checked')
                .map(function () { return $(this).val(); })
                .get();

            const params = {
                testItem: $('#testItemSelect').val(),
                dateFrom: $('#dateFrom').val(),
                dateTo: $('#dateTo').val(),
                keyword: $('#keyword').val(),
                notifyStatus: notifyStatusFilters,
                trackStatus: trackStatusFilters
            };
            console.log(params);

            // 2. 呼叫 API 下載檔案
            $('#exportExcel').prop('disabled', true).text('匯出中...');
            $.ajax({
                url: '/api/report/export',
                type: 'GET',
                data: params,
                traditional: true, // 讓陣列序列化成 notifyStatus=a&notifyStatus=b
                xhrFields: { responseType: 'blob' },
                success: function (blob, status, xhr) {
                    // 從 Content-Disposition 取得檔名
                    const dispo = xhr.getResponseHeader('Content-Disposition') || '';
                    const match = dispo.match(/filename\*=UTF-8''([^;]+)|filename="?([^"]+)"?/);
                    const filename = decodeURIComponent((match && (match[1] || match[2])) || 'reports.xlsx');

                    // 建立下載連結
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                },
                error: function () {
                    alert('匯出失敗，請稍後再試');
                },
                complete: function () {
                    $('#exportExcel').prop('disabled', false).text('匯出 Excel 檔案');
                }
            });
        });

        loadReports(1);
        window.addEventListener('message', function (event) {
            if (event.data && event.data.type === 'refreshReportList') {
                loadReports(1);
            }
        });

        // 篩選項目變更時重新查詢
        $('#testItemSelect, #dateFrom, #dateTo').on('change', function () {
            loadReports(1);
        });
        // 關鍵字輸入即時觸發
        $('#keyword').on('input', function () {
            loadReports(1);
        });
        //勾選項目做篩選
        $('input[name="notifyStatus"], input[name="trackStatus"]').on('change', function () {
            loadReports(1);
        });
        loadDistinctOptions();
    });

    function getSelectedValues(name) {
        return $('input[name="' + name + '"]:checked').map(function () {
            return this.value;
        }).get();
    }

    function loadReports(page) {
        // 讀取 checkbox 勾選值
        const notifyStatusFilters = $('input[name="notifyStatus"]:checked')
            .map(function () { return $(this).val(); })
            .get();

        const trackStatusFilters = $('input[name="trackStatus"]:checked')
            .map(function () { return $(this).val(); })
            .get();

        const params = {
            page: page,
            pageSize: 10,
            testItem: $('#testItemSelect').val(),
            dateFrom: $('#dateFrom').val(),
            dateTo: $('#dateTo').val(),
            keyword: $('#keyword').val(),
            notifyStatus: notifyStatusFilters,
            trackStatus: trackStatusFilters
        };

        $.ajax({
            url: '/api/report',
            type: 'GET',
            data: params,
            traditional: true, // 讓陣列參數正確序列化為 notifyStatus=0&notifyStatus=1
            success: function (res) {
                renderTable(res.data);
                renderPagination(res.page, res.pageSize, res.total);
            },
            error: function () {
                $('#reportTableBody').html('<tr><td colspan="12" class="text-danger text-center">查詢失敗，請稍後再試</td></tr>');
            }
        });
    }

    function renderTable(reports) {
        const tbody = $('#reportTableBody');
        tbody.empty();

        if (!reports || reports.length === 0) {
            tbody.append('<tr><td colspan="12" class="text-center">查無資料</td></tr>');
            return;
        }

        $.each(reports, function (i, r) {
            const row = `
                <tr>
                    <td>${i + 1}</td>
                    <td>${r.specimenNumber || ''}</td>
                    <td>${r.name || ''}</td>
                    <td>${r.testItem || ''}</td>
                    <td>${r.testingDate ? r.testingDate.substring(0, 10) : ''}</td>
                    <td>${r.reportDate ? r.reportDate.substring(0, 10) : ''}</td>
                    <td>${r.inspectionInstitution || ''}</td>
                    <td>${r.sendingPhysicianName || ''}</td>
                    <td>${r.notificationStatus || ''}</td>
                    <td>${r.trackingStatus || ''}</td>
                    @* <td><button onclick="editReport(${r.id})" target="_blank">編輯</button></td> *@
                    <td><a href="javascript:void(0);" onclick="openEditPage(${r.id})" class="btn btn-sm btn-primary">編輯</a></td>
                    <td><button onclick="viewReport(${r.id})" target="_blank">檢視</button></td>
                </tr>
            `;
            tbody.append(row);
        });
    }

    function renderPagination(page, pageSize, total) {
        const container = $('#pagination');
        container.empty();

        const totalPages = Math.ceil(total / pageSize);
        for (let i = 1; i <= totalPages; i++) {
            const btn = $('<button>')
                .text(i)
                .prop('disabled', i === page)
                .on('click', function () {
                    loadReports(i);
                });
            container.append(btn);
        }
    }

    function editReport(id) {
        window.location.href = `/Report/Edit/${id}`;
    }

    function viewReport(id) {
        window.location.href = `/Report/View/${id}`;
    }

    function openEditPage(reportId) {
        window.open(`/Report/Edit/${reportId}`, '_blank');
    }

    function loadDistinctOptions() {
        $.ajax({
            url: '/api/report/specimen-types/test_item',
            type: 'GET',
            success: function (types) {
                const $select = $('#testItemSelect');
                $select.empty();
                $select.append('<option value="">全部</option>');
                types.forEach(t => {
                    $select.append(`<option value="${t}">${t}</option>`);
                });
            },
            error: function () {
                console.warn("項目載入失敗");
            }
        });
    }

</script>
}
