@model List<WebApplication_Dianthus.Models.TestItem>
@{
    ViewData["Title"] = "報表列表";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<div class="target-report-main">
    <div class="target-report-body">
        <!-- 篩選器 -->
        <div class="target-report-row">
            <div class="target-report-row-label"><label>檢測項目</label></div>
            <button id="btnItem" class="btn btn-primary">點我篩選</button>
            <div id="searchItem" style="min-width: 200px; max-width: 400px; overflow-x: auto; border: 1px black solid; display: -webkit-inline-box;"></div>
        </div>

        <div class="target-report-row">
            <div class="target-report-row-label"><label>追蹤範圍</label></div>
            <input type="date" id="dateFrom"> ～ <input type="date" id="dateTo">
        </div>

        <div class="target-report-row">
            <div class="target-report-row-label"><label>案件狀態</label></div>
            <div class="target-report-input">
                <div><input type="checkbox" name="notifyStatus" value="待通知"><label>待通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="待追蹤"><label>待追蹤</label></div>
                <div><input type="checkbox" name="notifyStatus" value="已通知"><label>已通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="已追蹤"><label>已追蹤</label></div>
                <div><input type="checkbox" name="notifyStatus" value="不需通知"><label>不需通知</label></div>
                <div><input type="checkbox" name="trackStatus" value="不需追蹤"><label>不需追蹤</label></div>
            </div>
        </div>

        <div class="target-report-row" style="position: relative;">
            <div class="target-report-row-label"><label>關鍵字</label></div>
            <div class="target-report-input">
                <input type="text" id="keyword" placeholder="輸入姓名/檢體編號...">
            </div>
            <div style="position: absolute; right: 10px;">
                <label>匯出Excel檔案</label>
                <button id="exportSimplifiedBtn" class="btn btn-outline-success">簡化匯出</button>
                <button id="exportFullBtn" class="btn btn-outline-success">完整匯出</button>

            </div>    
        </div>
        <div>
            <button id="serach" class="btn btn-primary" onclick=serach()>搜尋</button>
            <label style="font-size: smaller;">系統不會自動帶出資料，請輸入上方篩選條件並點選[搜尋]按鈕，謝謝</label>
        </div>

        <!-- 報表列表 -->
        <div style="height: 530px;margin-top: 20px;">
            <table class="table">
                <thead>
                    <tr>
                        <th>序號</th>
                        <th data-sort="specimenNumber"><span class="sort-icon">↑↓</span>檢體編號</th>
                        <th data-sort="specimenType"><span class="sort-icon">↑↓</span>檢體類別</th>
                        <th data-sort="inspectionProgress"><span class="sort-icon">↑↓</span>檢驗進度</th>
                        <th data-sort="mrNumber"><span class="sort-icon">↑↓</span>病歷號</th>
                        <th data-sort="name"><span class="sort-icon">↑↓</span>客戶姓名</th>
                        <th data-sort="testItemName"><span class="sort-icon">↑↓</span>檢測項目</th>
                        <th data-sort="receivedDate"><span class="sort-icon">↑↓</span>收件日期</th>
                        <th data-sort="testingDate"><span class="sort-icon">↑↓</span>採檢日期</th>
                        <th data-sort="reportDate"><span class="sort-icon">↑↓</span>報告日期</th>
                        <th data-sort="inspectionInstitution"><span class="sort-icon">↑↓</span>送檢院所</th>
                        <th>送檢醫師</th>
                        <th>評估狀態</th>
                        <th>通知狀態</th>
                        <th>追蹤狀態</th>
                        <th>編輯</th>
                        <th>檢視</th>
                        <th>說明衛教單</th>
                        <th>文獻</th>
                    </tr>
                </thead>
                <tbody id="reportTableBody">
                    <!-- JS 動態生成 -->
                </tbody>
            </table>
        </div>

        <!-- 分頁 -->
        <div id="pagination" style="margin-top: 10px;"></div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog" style="--bs-modal-width: 800px;">
        <div class="modal-content" style="">
            <div class="modal-header">
                <h5 class="modal-title">檢測項目篩選清單</h5>
                @* <button type="button" class="close" data-dismiss="modal" style="margin-left: 358px;">&times;</button> *@
            </div>
            <div class="modal-body" id="modalBody">
                <label for="" style="margin-left: 10px;">待篩選清單 (請點選項目移至下方欲篩選清單內)</label>
                <div style="border: 1px black solid; margin: 10px;width:746px;height:242px;">
                    <div class="form-group" id="testItemContainer" style="display: ruby;">
                        @foreach (TestItem item in Model)
                        {
                            <div class="test-item" data-id="@item.Id" style="">@item.name</div>
                        }
                    </div>
                </div>
                <label for="" style="margin-left: 10px;">欲篩選清單</label>
                <div  style="border: 1px black solid; margin: 10px;width:746px;height:242px;">
                    <div id="testItemSearchContainer" style="display: ruby;"></div>
                </div>
            </div>
            <button id="itemSaveBtn" class="btn btn-success" style="margin:10px">儲存</button>
        </div>
    </div>
</div>
@section Scripts {
<script>
    let originalTestItems = [];
    let currentFilter = {}; // 全域儲存目前查詢條件
    let currentReports = []; // 儲存目前頁面資料
    let sortField = null;
    let sortAsc = true;

    $(document).ready(function () {
        // 取得今天日期
        const today = new Date();

        // 計算前一個月的日期
        const prevMonth = new Date();
        prevMonth.setMonth(today.getMonth() - 1);

        // 格式化成 YYYY-MM-DD
        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // 設定 input 的 value
        document.getElementById('dateFrom').value = formatDate(prevMonth);
        document.getElementById('dateTo').value = formatDate(today);

        $('#btnItem').on('click', function(){
            $('#reportModal').modal('show');
        });

        $('#exportSimplifiedBtn').on('click', function () {
            var currentFilter = getCurrentFilter();
            fetch('/api/report/export/simplified', {
                method: 'POST',
                body: JSON.stringify(currentFilter),
                headers: { 'Content-Type': 'application/json' }
            }).then(res => res.blob()).then(blob => {
                saveAs(blob, '簡化報告.xlsx');
            });
        });

        $('#exportFullBtn').on('click', function () {
            var currentFilter = getCurrentFilter();
            fetch('/api/report/export/full', {
                method: 'POST',
                body: JSON.stringify(currentFilter),
                headers: { 'Content-Type': 'application/json' }
            }).then(res => res.blob()).then(blob => {
                saveAs(blob, '完整報告.xlsx');
            });
        });


        renderTable(0);
    });

    function getCurrentFilter() {
        return {
            testItemIds: $('#searchItem .test-item').map((_, el) => $(el).data('id')).get(),
            notifyStatus: $('input[name="notifyStatus"]:checked').map((_, el) => $(el).val()).get(),
            trackStatus: $('input[name="trackStatus"]:checked').map((_, el) => $(el).val()).get(),
            dateFrom: $('#dateFrom').val(),
            dateTo: $('#dateTo').val(),
            keyword: $('#keyword').val()
        };
    }


    document.addEventListener("DOMContentLoaded", function () {
        const topContainer = document.getElementById("testItemContainer");

        // 儲存原始資料
        originalTestItems = Array.from(topContainer.querySelectorAll(".test-item")).map(item => {
            return {
                id: item.dataset.id,
                name: item.textContent.trim()
            };
        });

        // 初始化點擊事件
        topContainer.querySelectorAll(".test-item").forEach(enableToggle);
    });

    document.getElementById("itemSaveBtn").addEventListener("click", () => {
        const bottomContainer = document.getElementById("testItemSearchContainer");
        const searchItem = document.getElementById("searchItem");

        // 清空主畫面
        searchItem.innerHTML = "";

        // 搬移下方項目
        bottomContainer.querySelectorAll(".test-item").forEach(item => {
            searchItem.appendChild(item);
        });

        // 清空下方
        bottomContainer.innerHTML = "";

        // 隱藏 modal
        const modal = bootstrap.Modal.getInstance(document.getElementById("reportModal"));
        modal.hide();
    });

    document.getElementById("btnItem").addEventListener("click", () => {
        const topContainer = document.getElementById("testItemContainer");
        const bottomContainer = document.getElementById("testItemSearchContainer");

        // 清空上方容器
        topContainer.innerHTML = "";

        // 重新渲染原始資料
        originalTestItems.forEach(item => {
            const div = document.createElement("div");
            div.className = "test-item";
            div.dataset.id = item.id;
            div.textContent = item.name;
            enableToggle(div);
            topContainer.appendChild(div);
        });

        // 顯示 modal
        const modal = new bootstrap.Modal(document.getElementById("reportModal"));
        modal.show();
    });

    document.getElementById("keyword").addEventListener("input", function () {
        const keyword = this.value.trim().toLowerCase();

        if (keyword === "") {
            renderTable(res.data);
            renderPagination(res.page, res.pageSize, res.total);
            return;
        }

        const filtered = currentReports.data.filter(r =>
            r.name?.toLowerCase().includes(keyword) ||
            r.specimenCode?.toLowerCase().includes(keyword) ||
            r.inspectionInstitution?.toLowerCase().includes(keyword) ||
            r.sendingPhysicianName?.toLowerCase().includes(keyword) ||
            r.specimenType?.toLowerCase().includes(keyword) ||
            r.specimenNumber?.toLowerCase().includes(keyword)
        );
        console.log("currentReports: ",currentReports)
        renderTable(currentReports.data);
        renderPagination(currentReports.page, currentReports.pageSize, currentReports.total);
    });


    function enableToggle(item) {
        item.addEventListener("click", () => {
            const currentParent = item.parentElement;
            const target = currentParent.id === "testItemContainer"
                ? document.getElementById("testItemSearchContainer")
                : document.getElementById("testItemContainer");
            target.appendChild(item);
        });
    }

    function serach() {
        const selectedItems = Array.from(document.querySelectorAll('#searchItem .test-item')).map(item => item.dataset.id);
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo = document.getElementById('dateTo').value;
        const notifyStatus = Array.from(document.querySelectorAll('input[name="notifyStatus"]:checked')).map(cb => cb.value);
        const trackStatus = Array.from(document.querySelectorAll('input[name="trackStatus"]:checked')).map(cb => cb.value);
        const keyword = document.getElementById('keyword').value.trim();

        // 計算有效條件數量
        let conditionCount = 0;
        if (selectedItems.length > 0) conditionCount++;
        if (dateFrom || dateTo) conditionCount++;
        if (notifyStatus.length > 0 || trackStatus.length > 0) conditionCount++;
        if (keyword !== "") conditionCount++;

        // 限制：至少要有兩項條件
        if (conditionCount < 2) {
            alert("請至少選擇兩項篩選條件，避免查詢過多資料！");
            return;
        }

        // 打包資料
        currentFilter  = {
            testItemIds: selectedItems,
            dateFrom,
            dateTo,
            notifyStatus,
            trackStatus,
            keyword,
            page: 1,
            pageSize: 10
        };
        console.log("送出查詢條件：", currentFilter);
        // 傳送到後端
        fetch('/api/report/search', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(currentFilter)
        })
        .then(response => response.json())
        .then(res => {
            console.log("後端回傳結果：", res);
            currentReports = res;
            renderTable(res.data);
            renderPagination(res.page, res.pageSize, res.total);
            // 可更新畫面
        })
        .catch(error => {
            console.error("搜尋失敗：", error);
        });
    }

    function getSelectedValues(name) {
        return $('input[name="' + name + '"]:checked').map(function () {
            return this.value;
        }).get();
    }

    function loadReports(page) {
        if (!currentFilter || Object.keys(currentFilter).length === 0) {
            alert("尚未執行查詢，請先選擇條件後點擊查詢");
            return;
        }

        const selectedItems = Array.from(document.querySelectorAll('#searchItem .test-item')).map(item => item.dataset.id);
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo = document.getElementById('dateTo').value;
        const notifyStatus = Array.from(document.querySelectorAll('input[name="notifyStatus"]:checked')).map(cb => cb.value);
        const trackStatus = Array.from(document.querySelectorAll('input[name="trackStatus"]:checked')).map(cb => cb.value);
        const keyword = document.getElementById('keyword').value.trim();

        // 計算有效條件數量
        let conditionCount = 0;
        if (selectedItems.length > 0) conditionCount++;
        if (dateFrom || dateTo) conditionCount++;
        if (notifyStatus.length > 0 || trackStatus.length > 0) conditionCount++;
        if (keyword !== "") conditionCount++;

        // 限制：至少要有兩項條件
        if (conditionCount < 2) {
            alert("請至少選擇兩項篩選條件，避免查詢過多資料！");
            return;
        }

        const params = {
            testItemIds: selectedItems,
            dateFrom,
            dateTo,
            notifyStatus,
            trackStatus,
            keyword,
            page: page,
            pageSize: 10
        };
        console.log("送出查詢條件：", params);
        fetch('/api/report/search', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(params)
        })
        .then(response => response.json())
        .then(res => {
            console.log("後端回傳結果：", res);
            currentReports = res;
            renderTable(res.data);
            renderPagination(res.page, res.pageSize, res.total);
            // 可更新畫面
        })
        .catch(error => {
            console.error("搜尋失敗：", error);
            $('#reportTableBody').html('<tr><td colspan="12" class="text-danger text-center">查詢失敗，請稍後再試</td></tr>');
        });
    }

    function renderTable(reports) {
        const tbody = $('#reportTableBody');
        tbody.empty();

        if (!reports || reports.length === 0) {
            tbody.append('<tr><td colspan="17" class="text-center">查無資料</td></tr>');
            return;
        }

        $.each(reports, function (i, r) {
            const notifyColor = getStatusColor(r.notificationStatus);
            const trackColor = getStatusColor(r.trackingStatus);
            const assColor = getStatusColor(r.assessmentStatus);

            const row = `
                <tr>
                    <td>${i + 1}</td>
                    <td>${r.specimenNumber || ''}</td>
                    <td>${r.specimenType || ''}</td>
                    <td>${r.inspectionProgress || ''}</td>
                    <td>${r.mrNumber || ''}</td>
                    <td>${r.name || ''}</td>
                    <td>${r.testItemName || ''}</td>
                    <td>${r.receivedDate ? r.receivedDate.substring(0, 10) : ''}</td>
                    <td>${r.testingDate ? r.testingDate.substring(0, 10) : ''}</td>
                    <td>${r.reportDate ? r.reportDate.substring(0, 10) : ''}</td>
                    <td>${r.inspectionInstitution || ''}</td>
                    <td>${r.sendingPhysicianName || ''}</td>
                    <td><div style="width: 75px;background-color: ${assColor}; color: white;border-radius: 10px;text-align: center;">${r.assessmentStatus || ''}</div></td>
                    <td><div style="width: 75px;background-color: ${notifyColor}; color: white;border-radius: 10px;text-align: center;">${r.notificationStatus || ''}</div></td>
                    <td><div style="width: 75px;background-color: ${trackColor}; color: white;border-radius: 10px;text-align: center;">${r.trackingStatus || ''}</div></td>
                    <td><a href="javascript:void(0);" onclick="openEditPage(${r.id})" class="btn btn-sm btn-primary">編輯</a></td>
                    <td><button class="btn btn-sm btn-warning" onclick="viewReport('report',${r.id})">檢視</button></td>
                    <td><button class="btn btn-sm btn-success" onclick="viewReport('teachreport',${r.id})">說明衛教單</button></td>
                    <td><button class="btn btn-sm btn-info" onclick="viewReport('paperreport',${r.id})">文獻</button></td>
                </tr>
            `;
            tbody.append(row);
        });
    }

    function renderPagination(page, pageSize, total) {
        const container = $('#pagination');
        container.empty();

        const totalPages = Math.ceil(total / pageSize);
        for (let i = 1; i <= totalPages; i++) {
            const btn = $('<button>')
                .text(i)
                .prop('disabled', i === page)
                .on('click', function () {
                    loadReports(i);
                });
            container.append(btn);
        }
    }

    function viewReport(type,id) {
        console.log(type);
        const url = `/pdf/${type}.pdf`;
        window.open(url, '_blank');
        @* 若每筆資料對應不同 PDF
            const url = `/PDF/report_${id}.pdf`;
            window.open(url, '_blank');
         *@
    }

    function openEditPage(reportId) {
        window.open(`/Report/Edit/${reportId}`, '_blank');
    }

    function getStatusColor(status) {
        switch (status) {
            case '已通知':
            case '已追蹤':
            case '已評估':
                return '#28a745'; // 綠色
            case '待通知':
            case '待追蹤':
            case '待評估':
                return '#dc3545'; // 紅色
            case '不需通知':
            case '不需追蹤':
            case '不需評估':
                return '#6c757d'; // 灰色
            default:
                return 'transparent'; // 無色
        }
    }
    
    $('th[data-sort]').on('click', function () {
        const field = $(this).data('sort');

        if (sortField === field) {
            sortAsc = !sortAsc; // 反轉排序方向
        } else {
            sortField = field;
            sortAsc = true;
        }

        // 排序資料
        currentReports.data.sort((a, b) => {
            let valA = a[field] || '';
            let valB = b[field] || '';

            // 日期欄位處理
            if (field.toLowerCase().includes('date')) {
                valA = new Date(valA);
                valB = new Date(valB);
            }

            if (valA < valB) return sortAsc ? -1 : 1;
            if (valA > valB) return sortAsc ? 1 : -1;
            return 0;
        });

        // 重繪畫面
        renderTable(currentReports.data);
        renderPagination(currentReports.page, currentReports.pageSize, currentReports.total);
        updateSortIcons();

    });

    function updateSortIcons() {
        $('th[data-sort]').each(function () {
            const field = $(this).data('sort');
            const icon = $(this).find('.sort-icon');

            if (field === sortField) {
                icon.text(sortAsc ? '↑' : '↓');
            } else {
                icon.text('↑↓');
            }
        });
    }


</script>
}
<style>
    .table tbody tr:hover td {
        background-color: #e6f7ff; /* 淺藍色高亮 */
    }
    .test-item {
        width: 100px; 
        height: 30px; 
        cursor: pointer;
        display: flex; 
        justify-content: center; 
        align-items: center; 
        text-align: center; 
        flex-direction: column;
    }
    .test-item:hover {
        background-color: #e0f7ff; /* ✅ 高亮背景 */
        border-color: #3399ff;     /* ✅ 高亮邊框 */
    }

    th[data-sort] {
        cursor: pointer;
    }
    .sort-icon {
        margin-right: 4px;
        color: #888;
    }
    th[data-sort]:hover .sort-icon {
        color: #000;
    }

</style>