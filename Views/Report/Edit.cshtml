<input type="hidden" id="reportId" value="@Model.Id" />
<input type="hidden" id="name" value="@Model.Name" />
<input type="hidden" id="mrNumber" value="@Model.MrNumber" />
<input type="hidden" id="inspectionInstitution" value="@Model.InspectionInstitution" />
<input type="hidden" id="sendingPhysicianName" value="@Model.SendingPhysicianName" />
<input type="hidden" id="weeksOfPregnancy" value="@Model.WeeksOfPregnancy" />
<input type="hidden" id="currentUserName" value="@ViewBag.CurrentUserName">
<input type="hidden" id="currentUserId" value="@ViewBag.CurrentUserID" />

<script>
    $(document).ready(function () {
        const reportId = getReportIdFromUrl();

        $.ajax({
            url: `/api/report/${reportId}`,
            type: 'GET',
            success: function (report) {
                fillReportDetails(report);
            },
            error: function () {
                alert("載入報告資料失敗");
            }
        });
        
        function getReportIdFromUrl() {
            const parts = window.location.pathname.split('/');
            return parts[parts.length - 1];
        }

        function formatDate(dateStr) {
            return dateStr ? dateStr.substring(0, 10) : '';
        }
        
        //產生Confirm檢體類別Select=>option
        loadSpecimenTypeOptions("confirm_specimen_type");

        function fillReportDetails(r) {
            $('#nameLabel').text(r.name || '');
            $('#birthDateLabel').text(formatDate(r.birthday));
            $('#genderLabel').text(r.gender || '');
            $('#idNumberLabel').text(r.idNumber || '');
            $('#phoneLabel').text(r.phone || '');
            $('#indicationLabel').text(r.indication || '');
            $('#specimenNumberLabel').text(r.specimenNumber || '');
            $('#testingDateLabel').text(formatDate(r.testingDate));
            $('#reportDateLabel').text(formatDate(r.reportDate));
            $('#confirmSpecimenTypeLabel').text(r.confirmSpecimenType || '');
            $('#weeksOfPregnancyLabel').text(r.weeksOfPregnancy || '');
            $('#dueDateLabel').text(formatDate(r.dueDate));
            $('#inspectionInstitutionLabel').text(r.inspectionInstitution || '');
            $('#responsibleBusinessPersonLabel').text(r.responsibleBusinessPerson || '');
            $('#businessManagerLabel').text(r.businessManager || '');
            $('#sendingPhysicianNameLabel').text(r.sendingPhysicianName || '');
            $('#responsibleBusinessPhoneLabel').text(r.responsibleBusinessPhone || '');
            $('#businessManagerPhoneLabel').text(r.businessManagerPhone || '');
            $('#inspectionInstitutionPhoneLabel').text(r.inspectionInstitutionPhone || '');
            $('#responsibleBusinessEmailLabel').text(r.responsibleBusinessEmail || '');
            $('#businessManagerEmailLabel').text(r.businessManagerEmail || '');
            $('#abnormalReportDeliveryMethodLabel').text(r.abnormalReportDeliveryMethod || '');
            $('#abnormalReportNotificationMethodLabel').text(r.abnormalReportNotificationMethod || '');
            $('#inspectionGroupLabel').text(r.inspectionGroup || '');
            $('#reportResultsLabel').text(r.reportResults || '');
            $('#notificationStatusSelect').val(r.notificationStatus || '');
            $('#notificationCircumstancesInput').val(r.notificationCircumstances || '');
            $('#trackingStatusSelect').val(r.trackingStatus || '');
            $('#prenatalTrackingTimeLabel').text(formatDate(r.prenatalTestingProjectTrackingTime));
            $('#confirmSubmissionTimeInput').val(formatDate(r.confirmSpecimenSubmissionTime));
            $('#confirmSpecimenTypeSelect').val(r.confirmSpecimenType || '');
            $('#confirmReportResultInput').val(r.confirmTheTestReportResults || '');
            $('#trackingTimeLabel').text(formatDate(r.trackingTime));
            $('#nipsFollowupTimeLabel').text(formatDate(r.trackingTheFollowupStatusOfNIPS_Cases));
            $('#trackingLabel').text(r.tracking || '');
            $('#trackingResultsLabel').text(r.trackingResults || '');
            $('#referralInstitutionInput').val(r.referralInstitution || '');
            $('#referringPhysicianInput').val(r.referringPhysician || '');
            $('#remarkIcon').val(r.remark || '');
            if (!$('#notificationStatusSelect').val() || !$('#trackingStatusSelect').val()) {
                alert("請選擇通知狀態與追蹤狀態");
                return;
            }
        }

        $('#saveBtn').on('click', function () {
            const $btn = $(this);
            $btn.prop('disabled', true).text('儲存中...');

            //調整存入日期格式
            const dateStr = $('#confirmSubmissionTimeInput').val(); // '2025-10-20'
            const fullDate = dateStr ? dateStr + 'T00:00:00' : null;
            const updated = {
                id: reportId,
                notificationStatus: $('#notificationStatusSelect').val(),
                trackingStatus: $('#trackingStatusSelect').val(),
                notificationCircumstances: $('#notificationCircumstancesInput').val(),
                confirmSpecimenSubmissionTime: fullDate,
                confirmSpecimenType: $('#confirmSpecimenTypeSelect').val(),
                confirmTheTestReportResults: $('#confirmReportResultInput').val(),
                referralInstitution: $('#referralInstitutionInput').val(),
                referringPhysician: $('#referringPhysicianInput').val(),
                remark: $('#remarkIcon').val()
            };
            $.ajax({
                url: `/api/report/${reportId}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(updated),
                success: function () {
                    alert("儲存成功，即將返回報表列表");
                    // 通知主頁刷新，關閉分頁
                    if (window.opener && !window.opener.closed) {
                        window.opener.postMessage({ type: 'refreshReportList' }, '*');
                    }
                    window.close();
                    @* window.location.href = "/Report/Index"; // ← 跳轉回列表路徑 *@
                },
                error: function () {
                    alert("儲存失敗，請稍後再試");
                    $btn.prop('disabled', false).text('儲存');
                }
            });
        });

        const templateSelectModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("templateSelectModal"));
        const emailPreviewModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("emailPreviewModal"));
        const confirmSendModal = bootstrap.Modal.getOrCreateInstance(document.getElementById("confirmSendModal"));
        const emailContentEl = document.getElementById("emailContent");
        const recipientContainer = document.getElementById("recipientContainer");
        const addRecipientBtn = document.getElementById("addRecipientBtn");
        const emailPreviewModalEl = document.getElementById("emailPreviewModal");

        // 新增收件人欄位
        addRecipientBtn.addEventListener("click", function () {
            const group = document.createElement("div");
            group.className = "input-group mb-2 recipient-group";
            group.style = ""
            const input = document.createElement("input");
            input.type = "email";
            input.className = "form-control recipientEmail";
            input.placeholder = "輸入收件人";

            const removeBtn = document.createElement("button");
            removeBtn.type = "button";
            removeBtn.className = "btn btn-outline-danger removeRecipientBtn";
            removeBtn.style ="border-color: gainsboro";
            removeBtn.textContent = "✖";
            removeBtn.addEventListener("click", function () {
                group.remove();
            });

            group.appendChild(input);
            group.appendChild(removeBtn);
            recipientContainer.appendChild(group);
        });

        // 當 Modal 關閉（包含按取消或右上角 X）
        emailPreviewModalEl.addEventListener("hidden.bs.modal", function () {
            // 重置收件人欄位
            recipientContainer.innerHTML = `
                <label for="recipientEmail" class="form-label">收件人</label>
                <input type="email" class="form-control recipientEmail" style="margin-bottom: 10px;" id="recipientEmail" value="limingchiu@mfmclinic.com.tw">
            `;
        });

        // 共用：取值函式
        function getFieldValue(id) {
            return document.getElementById(id)?.value || "未提供";
        }

        // 打開範本選擇 Modal
        document.getElementById("openSendMail").addEventListener("click", function () {
            templateSelectModal.show();
        });

        // 範本 A
        document.getElementById("reviewMailBtn1").addEventListener("click", function () {
            const content = `
            您好
            NIPS/aCGH有 1 位異常個案如下：

                報告編號：${getFieldValue("reportId")}
                個案姓名：${getFieldValue("name")}
                病歷號：${getFieldValue("mrNumber")}
                送檢院所：${getFieldValue("inspectionInstitution")}
                送檢醫師：${getFieldValue("sendingPhysicianName")}
                報告結果：${getFieldValue("confirmReportResultInput")}
                請問此個案後續狀況如何？
                是否繼續懷孕或是終止妊娠(引產時間點)？
                    `;
            emailContentEl.textContent = content;
            templateSelectModal.hide();
            emailPreviewModal.show();
        });

        // 範本 B
        document.getElementById("reviewMailBtn2").addEventListener("click", function () {
            const content = `
            您好
            1 位異常個案如下：

                報告編號：${getFieldValue("reportId")}
                個案姓名：${getFieldValue("name")}
                病歷號：${getFieldValue("mrNumber")}
                送檢院所：${getFieldValue("inspectionInstitution")}
                送檢醫師：${getFieldValue("sendingPhysicianName")}
                報告結果：${getFieldValue("confirmReportResultInput")}
                此個案已懷孕滿 ${getFieldValue("weeksOfPregnancy")} 週，請問個案後續狀況如何?

            (NIPS異常個案)
            1. 是否抽羊水？如是，抽羊水時間？
            或
            2. 已轉它院（檢體是否會進件？ 或 無法追蹤？）

            (CS異常個案)
            此個案已懷孕 ${getFieldValue("weeksOfPregnancy")} 週，請協助詢問配偶是否進行檢測？
                    `;
            emailContentEl.textContent = content;
            templateSelectModal.hide();
            emailPreviewModal.show();
        });

        // 按「寄出」 → 先跳確認視窗
        document.getElementById("sendEmailBtn").addEventListener("click", function () {
            confirmSendModal.show();
        });

        // 寄送信件
        document.getElementById("confirmSendBtn").addEventListener("click", async function () {
            const sender = document.getElementById("senderEmail").value;
            const recipients = Array.from(document.querySelectorAll(".recipientEmail"))
                .map(input => input.value.trim())
                .filter(email => email !== "");

            const content = document.getElementById("emailContent").textContent;

            try {
                const res = await fetch("/api/email/send", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ sender, recipients, content })
                });

                const raw = await res.text(); // 先拿原始文字
                let json;

                try {
                    json = JSON.parse(raw); // 嘗試轉成 JSON
                } catch (err) {
                    console.error("回傳不是 JSON：", raw);
                    alert("寄信錯誤：回傳格式不正確");
                    return;
                }

                if (json.success) {
                    alert("信件已成功寄出！");
                    bootstrap.Modal.getInstance(document.getElementById("confirmSendModal")).hide();
                    bootstrap.Modal.getInstance(document.getElementById("emailPreviewModal")).hide();

                    // 重置收件人欄位
                    recipientContainer.innerHTML = `
                        <label class="form-label">收件人</label>
                        <div class="input-group mb-2 recipient-group">
                            <input type="email" class="form-control recipientEmail" placeholder="輸入收件人">
                            <button type="button" class="btn btn-outline-danger removeRecipientBtn" style="border-color: gainsboro;">✖</button>
                        </div>
                    `;
                    document.querySelector(".removeRecipientBtn").addEventListener("click", function () {
                        this.closest(".recipient-group").remove();
                    });
                } else {
                    alert("寄信失敗：" + json.message);
                }
            } catch (err) {
                alert("寄信錯誤：" + err);
            }
        });

        // 從 hidden inputs 取得必要資訊
        const remarkInput = document.getElementById("remarkInput");
        const remarkBtn = document.getElementById("remarkBtn");
        const remarkList = document.getElementById("remarkList");
        const remarkContainer = document.getElementById("remarkContainer");

        const currentUserId = document.getElementById("currentUserId").value;
        const currentUserName = document.getElementById("currentUserName").value;

        // 頁面載入時先載入紀錄
        loadRecords();
        loadTrackingTimeline();

        async function loadTrackingTimeline() {
            try {
                const res = await fetch(`/api/trackingtimeline/report/${reportId}`);
                if (!res.ok) throw new Error("載入失敗");

                const items = await res.json();
                document.getElementById("timelineList").innerHTML = ""; // 清空列表

                items.forEach(item => renderTimelineItem(item));
            } catch (err) {
                alert("載入追蹤時間軸失敗：" + err.message);
            }
        }

        function renderTimelineItem(item) {
            const li = document.createElement("li");
            li.dataset.id = item.id;

            li.innerHTML = `
                <a data-id="${item.currentUserId}">${item.name}</a>
                <a class="float-right">${item.trackingDate ? item.trackingDate.split("T")[0] : ""}</a>
                <p>${item.status}</p>
                <p>${item.content ?? ""}</p>
                <button class="btn btn-sm btn-link edit-btn">編輯</button>
            `;

            document.getElementById("timelineList").appendChild(li);
        }

        async function loadRecords() {
            const res = await fetch(`/api/consultrecord/${reportId}`);
            const records = await res.json();

            remarkList.innerHTML = "";
            records.forEach(r => renderRecord(r));
            remarkContainer.scrollTop = remarkContainer.scrollHeight;
        }

        function renderRecord(record) {
            const li = document.createElement("li");
            li.dataset.id = record.id;

            // 格式化時間：把 ISO 8601 轉成 yyyy-MM-dd HH:mm:ss
            const date = new Date(record.createdAt);
            const formattedDate =
                date.getFullYear() + "-" +
                String(date.getMonth() + 1).padStart(2, "0") + "-" +
                String(date.getDate()).padStart(2, "0") + " " +
                String(date.getHours()).padStart(2, "0") + ":" +
                String(date.getMinutes()).padStart(2, "0") + ":" +
                String(date.getSeconds()).padStart(2, "0");

            let actionButtons = "";
            let content = record.content || ""; // 防止 null 或 undefined
            let isLong = content.length > 100;

            if (record.currentUserId === @ViewBag.CurrentUserID) {
                actionButtons = `
                    <button class="btn btn-link p-0" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end">
                        <button class="dropdown-item edit-btn" data-id="${record.id}">編輯</button>
                        <button class="dropdown-item text-danger delete-btn" data-id="${record.id}">刪除</button>
                    </div>

                `;
            }

            li.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <span class="date">${formattedDate}</span>
                    <div class="dropdown">
                        ${actionButtons}
                    </div>
                </div>
                <div class="d-flex align-items-center mb-1">
                    <div class="name" data-id="${record.currentUserId}">${record.name}</div>
                    ${isLong ? `<button class="btn btn-sm btn-link toggle-btn me-1">▼ 展開</button>` : ""}
                </div>
                <p class="note collapsed">${content}</p>
            `;
            remarkList.appendChild(li);
        }

        // 加入Remark收闔事件
        remarkList.addEventListener("click", function (e) {
            const toggleBtn = e.target.closest(".toggle-btn");
            if (!toggleBtn) return;

            const note = toggleBtn.closest("li").querySelector(".note");

            if (note.classList.contains("collapsed")) {
                // 展開 → 顯示完整
                note.classList.remove("collapsed");
                toggleBtn.textContent = "▲ 收合";
            } else {
                // 收合 → 限制高度
                note.classList.add("collapsed");
                toggleBtn.textContent = "▼ 展開";
            }
        });
        // 新增紀錄
        remarkBtn.addEventListener("click", async function () {
            const content = remarkInput.value.trim();
            if (!content) return;

            const res = await fetch(`/api/consultrecord`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    reportId: reportId,
                    name: currentUserName,
                    content: content
                })
            });

            const result = await res.json();
            await loadRecords(); // 重新載入紀錄

            remarkInput.value = "";
            remarkContainer.scrollTop = remarkContainer.scrollHeight;
        });

        // 刪除紀錄
        remarkList.addEventListener("click", async function (e) {
            const deleteBtn = e.target.closest(".delete-btn");
            if (deleteBtn) {
                const id = deleteBtn.dataset.id;
                if (!id) return console.error("刪除失敗：按鈕沒有 data-id");

                const res = await fetch(`/api/consultrecord/${id}`, { method: "DELETE" });
                if (res.ok) {
                    await loadRecords(); // 重新載入紀錄
                }
            }
        });

        // 編輯紀錄
        remarkList.addEventListener("click", function (e) {
            const editBtn = e.target.closest(".edit-btn");
            if (!editBtn) return;

            const li = editBtn.closest("li");
            if (!li) return;

            const note = li.querySelector(".note");
            if (!note || li.querySelector("textarea")) return;

            // 建立 textarea
            const textarea = document.createElement("textarea");
            textarea.className = "form-control mt-2";
            textarea.value = note.textContent;

            // 建立儲存按鈕
            const saveBtn = document.createElement("button");
            saveBtn.className = "btn btn-sm btn-success mt-2 me-2";
            saveBtn.textContent = "儲存";

            // 建立取消按鈕
            const cancelBtn = document.createElement("button");
            cancelBtn.className = "btn btn-sm btn-secondary mt-2";
            cancelBtn.textContent = "取消";

            // 替換 note → textarea
            note.replaceWith(textarea);
            li.appendChild(saveBtn);
            li.appendChild(cancelBtn);

            // 儲存事件
            saveBtn.addEventListener("click", async function () {
                const id = li.dataset.id;
                if (!id) {
                    console.error("編輯失敗：li 沒有 data-id");
                    return;
                }

                const newContent = textarea.value;

                const res = await fetch(`/api/consultrecord/${id}`, {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ content: newContent })
                });

                if (res.ok) {
                    const newNote = document.createElement("p");
                    newNote.className = "note";
                    newNote.textContent = newContent;

                    textarea.replaceWith(newNote);
                    saveBtn.remove();
                    cancelBtn.remove();
                    remarkContainer.scrollTop = remarkContainer.scrollHeight;
                } else {
                    console.error("更新失敗：", await res.text());
                }
            });

            // 取消事件
            cancelBtn.addEventListener("click", function () {
                const originalNote = document.createElement("p");
                originalNote.className = "note";
                originalNote.textContent = note.textContent; // 回復原本內容

                textarea.replaceWith(originalNote);
                saveBtn.remove();
                cancelBtn.remove();
            });
        });



       document.getElementById("confirmAddBtn").addEventListener("click", async function () {
            const content = document.getElementById("contentInput").value.trim();
            const date = document.getElementById("dateInput").value;
            if (!date) {
                alert("請輸入日期！");
                return;
            }

            try {
                // 呼叫後端 API 建立 TrackingTimeline
                const res = await fetch("/api/trackingtimeline", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        reportId: reportId,          // 後端需要的報告 ID
                        currentUserId: currentUserId, // 當前使用者 ID
                        name: currentUserName,
                        status: "待追蹤",
                        content: content,
                        trackingDate: date,
                        createdAt: date
                    })
                });

                if (!res.ok) {
                    throw new Error("新增失敗");
                }

                const newItem = await res.json();

                // 建立新的 li，使用後端回傳的資料
                const li = document.createElement("li");
                li.dataset.id = newItem.id;
                li.innerHTML = `
                    <a data-id="${newItem.current_user_id}">${newItem.name}</a>
                    <a class="float-right">${newItem.createdAt.split("T")[0]}</a>
                    <p>${newItem.status}</p>
                    <p>${newItem.content}</p>
                    <button class="btn btn-sm btn-link edit-btn">編輯</button>
                `;
                document.getElementById("timelineList").appendChild(li);

                // 關閉 Modal
                const modal = bootstrap.Modal.getInstance(document.getElementById("addItemModal"));
                modal.hide();

                // 清空輸入框
                document.getElementById("nameInput").value = "";
                document.getElementById("dateInput").value = "";
            } catch (err) {
                alert(err.message);
            }
        });
    });


    function loadSpecimenTypeOptions(columnName) {
        $.ajax({
            url: '/api/report/specimen-types/confirm_specimen_type',
            type: 'GET',
            success: function (types) {
                const $select = $('#confirmSpecimenTypeSelect');
                $select.empty();
                $select.append('<option value=""  disabled selected>請選擇</option>');
                types.forEach(t => {
                    $select.append(`<option value="${t}">${t}</option>`);
                });
            },
            error: function () {
                console.warn("項目載入失敗");
            }
        });
    }

    function cancelTargetReport(){
        if (confirm("確定要取消編輯並關閉分頁？")) {
            if (window.opener && !window.opener.closed) {
                window.opener.postMessage({ type: 'refreshReportList' }, '*');
            }
            window.close();
        }
    }
    
</script>
