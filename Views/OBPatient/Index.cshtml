@using System.Text.Json

@model OBPatientViewModel
@{
    ViewData["Title"] = "產科病患紀錄查詢系統";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var criteriaJson = JsonSerializer.Serialize(Model.SearchCriteria ?? new OBPatientSearchCriteria());
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-hospital-user me-2"></i>
                        產科病患紀錄查詢系統
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Form Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-search me-2"></i>
                        查詢條件
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Search" method="post" id="searchForm" class="needs-validation" novalidate>
                        <div class="row g-3">
                            <!-- Start Date -->
                            <div class="col-md-3">
                                <label asp-for="SearchCriteria.StartDate" class="form-label fw-bold">
                                    <i class="fas fa-calendar-alt me-1"></i>開始日期
                                </label>
                                <input asp-for="SearchCriteria.StartDate" class="form-control" type="date" required />
                                <span asp-validation-for="SearchCriteria.StartDate" class="text-danger small"></span>
                            </div>

                            <!-- End Date -->
                            <div class="col-md-3">
                                <label asp-for="SearchCriteria.EndDate" class="form-label fw-bold">
                                    <i class="fas fa-calendar-alt me-1"></i>結束日期
                                </label>
                                <input asp-for="SearchCriteria.EndDate" class="form-control" type="date" required />
                                <span asp-validation-for="SearchCriteria.EndDate" class="text-danger small"></span>
                            </div>

                            <!-- Company -->
                            <div class="col-md-2">
                                <label asp-for="SearchCriteria.Company" class="form-label fw-bold">
                                    <i class="fas fa-building me-1"></i>公司
                                </label>
                                <input asp-for="SearchCriteria.Company" class="form-control" 
                                       placeholder="請輸入公司名稱" maxlength="50" />
                                <span asp-validation-for="SearchCriteria.Company" class="text-danger small"></span>
                            </div>

                            <!-- Patient Number -->
                            <div class="col-md-2">
                                <label asp-for="SearchCriteria.PatientNumber" class="form-label fw-bold">
                                    <i class="fas fa-id-card me-1"></i>病歷號
                                </label>
                                <input asp-for="SearchCriteria.PatientNumber" class="form-control" 
                                       placeholder="請輸入病歷號" maxlength="20" />
                                <span asp-validation-for="SearchCriteria.PatientNumber" class="text-danger small"></span>
                            </div>

                            <!-- Patient Name -->
                            <div class="col-md-2">
                                <label asp-for="SearchCriteria.PatientName" class="form-label fw-bold">
                                    <i class="fas fa-user me-1"></i>病患姓名
                                </label>
                                <input asp-for="SearchCriteria.PatientName" class="form-control" 
                                       placeholder="請輸入病患姓名" maxlength="50" />
                                <span asp-validation-for="SearchCriteria.PatientName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-search me-2"></i>查詢資料
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-lg" onclick="clearForm()">
                                        <i class="fas fa-undo me-2"></i>清除條件
                                    </button>
                                    @if (Model?.Records != null && Model.Records.Any())
                                    {
                                        <a class="btn btn-success"
                                            href='@Url.Action("ExportToExcel", "OBPatient", new { criteriaJson = criteriaJson })'
                                            target="_blank">
                                            匯出Excel
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Messages -->
    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>錯誤：</strong> @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>輸入驗證錯誤：</strong>
                    <ul class="mb-0 mt-2">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <!-- Statistics Section -->
    @if (Model?.Statistics != null && Model.Statistics.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-chart-bar me-2"></i>
                            統計資料
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var stat in Model.Statistics)
                            {
                                <div class="col-md-3 mb-3">
                                    <div class="card text-center bg-light">
                                        <div class="card-body">
                                            <h4 class="text-primary">@stat.Value</h4>
                                            <p class="card-text">@stat.Key</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Results Section -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-table me-2"></i>
                        查詢結果
                    </h5>
                    @if (Model?.Records != null && Model.Records.Any())
                    {
                        <span class="badge bg-light text-dark fs-6">
                            <i class="fas fa-list-ol me-1"></i>
                            共 @Model.TotalRecords 筆資料
                        </span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model?.Records != null && Model.Records.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped mb-0">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th scope="col" style="min-width: 100px;">
                                            <i class="fas fa-id-card me-1"></i>病歷號
                                        </th>
                                        <th scope="col" style="min-width: 100px;">
                                            <i class="fas fa-user me-1"></i>姓名
                                        </th>
                                        <th scope="col" class="text-center" style="min-width: 80px;">
                                            <i class="fas fa-bed me-1"></i>床號
                                        </th>
                                        <th scope="col" style="min-width: 120px;">
                                            <i class="fas fa-calendar-plus me-1"></i>入住日期
                                        </th>
                                        <th scope="col" style="min-width: 120px;">
                                            <i class="fas fa-calendar-minus me-1"></i>離開日期
                                        </th>
                                        <th scope="col" style="min-width: 100px;">
                                            <i class="fas fa-baby me-1"></i>分娩方式
                                        </th>
                                        <th scope="col" class="text-center" style="min-width: 100px;">
                                            <i class="fas fa-bed me-1"></i>產後床號
                                        </th>
                                        <th scope="col" style="min-width: 140px;">
                                            <i class="fas fa-calendar-check me-1"></i>產後床入住日期
                                        </th>
                                        <th scope="col" style="min-width: 140px;">
                                            <i class="fas fa-calendar-times me-1"></i>產後床離開日期
                                        </th>
                                        <th scope="col" style="min-width: 120px;">
                                            <i class="fas fa-calendar-alt me-1"></i>原始入住日期
                                        </th>
                                        <th scope="col" class="text-center" style="min-width: 80px;">
                                            <i class="fas fa-exchange-alt me-1"></i>轉床否
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.Records)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold">@record.病歷號</td>
                                            <td class="fw-bold">@record.姓名</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@record.床號</span>
                                            </td>
                                            <td>
                                                @if (record.入住日期.HasValue)
                                                {
                                                    <span class="text-success">@record.入住日期.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (record.離開日期.HasValue)
                                                {
                                                    <span class="text-danger">@record.離開日期.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">住院中</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.分娩方式))
                                                {
                                                    <span class="badge bg-info">@record.分娩方式</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(record.產後床號))
                                                {
                                                    <span class="badge bg-secondary">@record.產後床號</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (record.產後床入住日期.HasValue)
                                                {
                                                    <span class="text-success">@record.產後床入住日期.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (record.產後床離開日期.HasValue)
                                                {
                                                    <span class="text-danger">@record.產後床離開日期.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (record.原始入住日期.HasValue)
                                                {
                                                    <span class="text-primary">@record.原始入住日期.Value.ToString("yyyy-MM-dd")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(record.轉床否))
                                                {
                                                    @if (record.轉床否 == "是" || record.轉床否 == "Y" || record.轉床否 == "1")
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-check me-1"></i>是
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-times me-1"></i>否
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-search fa-3x text-muted"></i>
                            </div>
                            <h5 class="text-muted">查無符合條件的資料</h5>
                            <p class="text-muted">請調整查詢條件後重新搜尋</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Custom JavaScript -->
<script>
    // Set default dates on page load
    document.addEventListener('DOMContentLoaded', function() {
        const startDateInput = document.getElementById('@Html.IdFor(m => m.SearchCriteria.StartDate)');
        const endDateInput = document.getElementById('@Html.IdFor(m => m.SearchCriteria.EndDate)');
        
        // Set default dates if not already set
        if (!startDateInput.value) {
            const firstDayOfMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
            startDateInput.value = firstDayOfMonth.toISOString().split('T')[0];
        }
        
        if (!endDateInput.value) {
            const lastDayOfMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0);
            endDateInput.value = lastDayOfMonth.toISOString().split('T')[0];
        }
    });

    // Clear form function
    function clearForm() {
        document.getElementById('searchForm').reset();
        // Clear any validation messages
        document.querySelectorAll('.text-danger').forEach(el => el.textContent = '');
        // Reset default dates
        const firstDayOfMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
        const lastDayOfMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0);
        
        document.getElementById('@Html.IdFor(m => m.SearchCriteria.StartDate)').value = firstDayOfMonth.toISOString().split('T')[0];
        document.getElementById('@Html.IdFor(m => m.SearchCriteria.EndDate)').value = lastDayOfMonth.toISOString().split('T')[0];
    }

    // Form validation
    (function() {
        'use strict';
        window.addEventListener('load', function() {
            var forms = document.getElementsByClassName('needs-validation');
            var validation = Array.prototype.filter.call(forms, function(form) {
                form.addEventListener('submit', function(event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    // Auto-dismiss alerts after 10 seconds
    setTimeout(function() {
        document.querySelectorAll('.alert-dismissible').forEach(function(alert) {
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 10000);

    // Table row highlighting
    document.addEventListener('DOMContentLoaded', function() {
        const tableRows = document.querySelectorAll('tbody tr');
        tableRows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f8f9fa';
            });
            row.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    });
</script>

<!-- Custom CSS -->
