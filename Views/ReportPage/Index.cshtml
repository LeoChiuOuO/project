<body>
    @model List<WebApplication_Dianthus.Models.Report>
    <div style="position: absolute; width: 1295px; height: 100%;">
        <div>
            <div>
                <label>下拉選單</label><select><option>請選擇</option></select>
            </div>
            <div>
                <label>追蹤範圍</label>
                <input type="date" name="" id=""> ～ 
                <input type="date" name="" id="">
                <div style="width: 100%;display: flex; justify-content: space-between;">
                    <label>案件狀態</label>
                    <div><input type="checkBox"><label>待通知</label></div>
                    <div><input type="checkBox"><label>待追蹤</label></div>
                    <div><input type="checkBox"><label>已通知</label></div>
                    <div><input type="checkBox"><label>已追蹤</label></div>
                    <div><input type="checkBox"><label>不需通知</label></div>
                    <div><input type="checkBox"><label>不需追蹤</label></div>
                </div>
            </div>
            <div style="float: inline-end;margin-top: 10px;">
                <label>關鍵字</label>
                <button>匯出Excel檔案</button>
            </div>
        </div>
        <div>
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">序號</th>
                        <th scope="col">檢體編號</th>
                        <th scope="col">客戶姓名</th>
                        <th scope="col">檢測項目</th>
                        <th scope="col">採檢日期</th>
                        <th scope="col">報告日期</th>
                        <th scope="col">送檢院所</th>
                        <th scope="col">送檢醫師</th>
                        <th scope="col">通知狀態</th>
                        <th scope="col">追蹤狀態</th>
                        <th scope="col">編輯</th>
                        <th scope="col">檢視</th>
                        @* <th scope="col">說明建議單</th>
                        <th scope="col">文獻</th> *@
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0 ; i < Model.Count; i++){
                        <tr>
                            <td>@Model[i].Number</td>
                            <td>@Model[i].TestID</td>
                            <td>@Model[i].CustName</td>
                            <td>@Model[i].Item</td>
                            <td>@Model[i].DetectionDate.ToString("yyyy/MM/dd")</td>
                            <td>@Model[i].ReportDate.ToString("yyyy/MM/dd")</td>
                            <td>@Model[i].DetectionDepartment</td>
                            <td>@Model[i].DetectionDoctor</td>
                            <td>@Model[i].Notify</td>
                            <td>@Model[i].Track</td>
                            <td><button id=@Model[i].Edit class="btn btn-outline-primary" onclick="clickTargetReport()">編輯</button></td>
                            <td><button id=@Model[i].Review class="btn btn-outline-primary" onclick="clickTargetReport()">檢視</button></td>
                            @* <td><button id=@Model[i].Describe class="btn btn-outline-primary" onclick="clickTargetReport()">說明建議單</button></td>
                            <td><button id=@Model[i].Document class="btn btn-outline-primary" onclick="clickTargetReport()">文獻</button></td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div id="targetReport" class="target-report-off ">
        <div class="target-report-main">
            <h1>報告編輯頁面</h1>
            <div class="target-report-body">
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>個案姓名：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>個案生日：</label><label>XXX</label></div>
                    <div><label>性別：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>身分證號：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>連絡電話：</label><label>XXX</label></div>
                    <div><label>Indcation：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>檢體編號：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>採檢日期：</label><label>XXX</label></div>
                    <div><label>報告日期：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>檢體類別：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>懷孕週數：</label><label>XXX</label></div>
                    <div><label>預產期：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>送檢院所：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>負責業務：</label><label>XXX</label></div>
                    <div><label>業務主管：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>送檢醫師：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>負責業務電話：</label><label>XXX</label></div>
                    <div><label>業務主管電話：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>送檢院所電話：</label><label>XXX</label></div>
                    <div class="target-report-row-label""><label>負責業務Email：</label><label>XXX</label></div>
                    <div><label>業務主管Email：</label><label>XXXXXXXXXXXXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>異常報告寄送方式：</label><label>XXX</label></div>
                    <div><label>異常報告通知方式：</label><label>XXX</label></div>
                </div>
                <div>
                    <div><label>檢驗組別：</label><label>XXX</label></div>
                </div>
                <div>
                    <div><label>報告結果：</label><label>XXX</label></div>
                </div>
                <div class="target-report-input">
                    <div style="width: 300px;"><label>通知狀態：</label><select><option>請選擇</option></select></div>
                    <div><label>通知情形：</label><input type="text" name="" id=""></div>
                </div>
                <div class="target-report-input">
                    <div style="width: 300px;"><label>追蹤狀態：</label><select><option>請選擇</option></select></div>
                    <div><label>產前檢測項目追蹤時間：</label><label>XXX</label><button>發送郵件</button></div>
                </div>
                <div class="target-report-input">
                    <div class="target-report-row-label""><label>Confirm檢體進件時間：</label><input type="text" name="" id=""></div>
                    <div class="target-report-row-label""><label>Confirm檢體類別：</label><select><option>請選擇</option></select></div>
                    <div><label>Confirm檢體報告結果：</label><input type="text" name="" id=""></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>追蹤時間：</label><label>XXX</label></div>
                    <div><label>追蹤NIPS個案後續狀況時間：</label><label>XXX</label></div>
                </div>
                <div class="target-report-row">
                    <div class="target-report-row-label""><label>追蹤情形：</label><label>XXX</label></div>
                    <div><label>追蹤結果：</label><label>XXX</label></div>
                </div>
                <div class="target-report-input">
                    <div style="width: 300px;"><label>轉介院所：</label><input type="text" name="" id=""></div>
                    <div><label>轉介醫師：</label><input type="text" name="" id=""></div>
                </div>
                <div style=" margin-top: 10px;">
                    <div><label>備註：</label><input style="width: 500px;height:120px" type="text" name="" id=""></div>
                </div>
            </div>
            <div>
                <button onclick="cancelTargetReport()" style="width: 80px;height:40px; margin-top: 10px;margin-right: 20px;" class="btn btn-primary">儲存</button>
                <button onclick="cancelTargetReport()" style="width: 80px;height:40px; margin-top: 10px;" class="btn btn-secondary">取消</button>
            </div>
        </div>
    </div>
</body>

<script>
    function clickTargetReport(){
        document.getElementById("targetReport").className = "target-report-on";
    }

    function cancelTargetReport(){
        document.getElementById("targetReport").className = "target-report-off";
    }
</script>