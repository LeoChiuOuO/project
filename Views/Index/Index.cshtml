@{ ViewData["title"] = "Login";}
@using (Html.BeginForm("Login", "Index", new { ReturnUrl = Context.Request.Query["ReturnUrl"] }, FormMethod.Post, true, new { name = "loginForm", autocomplete = "off" })){
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    <div style="width: 200px; margin: 200px auto;">
        <h2>@ViewData["Title"]</h2>
        <div>
            <span>帳號:</span>
             @Html.TextBox("Account")
        </div>
        <div>
            <span>密碼:</span>
            @Html.Password("Password")
        </div>
        <button class="btn btn-primary" type="submit">登入</button>
        <a class="btn text-dark" href="/ReportPage">忘記密碼</a>
        <div style="color:red;">
            <!--顯示登入失敗訊息 -->
            @ViewBag.errorMsg
        </div>
    </div>
}

   