@model WebApplication_Dianthus.Models.User
@{
    ViewData["Title"] = "我的基本資料";
}

<h2>我的基本資料</h2>

@await Html.PartialAsync("_AlertMessages")

<form asp-action="Profile" method="post">
    <div class="form-group">
        <label>帳號</label>
        <input type="text" class="form-control" value="@Model.Account" readonly />
    </div>

    <div class="form-group">
        <label>姓名</label>
        <input type="text" class="form-control" value="@Model.Name" readonly />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="Email" class="form-control" value="@Model.Email" />
    </div>

    <div class="form-group">
        <label>新密碼</label>
        <input type="password" name="Password" class="form-control" />
        <small class="form-text text-muted">留空則不修改密碼</small>
    </div>

    <button type="submit" class="btn btn-primary">更新</button>
</form>