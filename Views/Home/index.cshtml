@model ReportDashboardViewModel

<div class="container-fluid">
    <h2>Welcome </h2>
    <h2>以下按鈕用於生成測試資料</h2>
    @* <button class="btn btn-primary" onclick="TestOne()">新增今日1筆測試用資料</button>
    <button class="btn btn-primary" onclick="Test100()">新增100筆測試用資料</button> *@
    <button class="btn btn-primary" onclick="TestOverTime()">新增1筆[逾期]測試用資料</button>
    <button class="btn btn-primary" onclick="TestHightLight()">新增1筆[需關懷]測試用資料</button>
</div>
<h2>報告統計儀表板</h2>
<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-header">未讀報告</div>
            <div class="card-body">
                <h5 class="card-title">@Model.UnreadCount</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">將要逾時 (報告未處理 20~30天)</div>
            <div class="card-body">
                <h5 class="card-title">@Model.UpcomingOverdueCount</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-header">已經逾時(報告未處理 30~60天)</div>
            <div class="card-body">
                <h5 class="card-title">@Model.OverdueCount</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-dark mb-3">
            <div class="card-header">嚴重逾時(報告未處理 60天以上)</div>
            <div class="card-body">
                <h5 class="card-title">@Model.CriticalOverdueCount</h5>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-danger mb-3">
            <div class="card-header">重大評估報告</div>
            <div class="card-body">
                <h5 class="card-title">@Model.CriticalAssessmentCount</h5>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>

    function showAlert(message, type) {
        const html = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>`;
        $('body').append(html);
        setTimeout(() => $('.alert').alert('close'), 3000);
    }

    function TestOne() { callTestApi('/Home/TestOne'); }
    function Test100() { callTestApi('/Home/Test100'); }
    function TestOverTime() { callTestApi('/Home/TestOverTime'); }
    function TestHightLight() { callTestApi('/Home/TestHightLight'); }

    function callTestApi(endpoint) {
        $.get(endpoint, function (res) {
            showAlert(res.success ? "資料已更新" : "更新失敗", res.success ? "success" : "danger");
             if (res.success) refreshDashboard();
             // 額外顯示該筆資料（僅限 TestHightLight）
            if (endpoint === '/Home/TestHightLight') {
                const detail = `新增報告 ➤ 姓名：${res.name}，病歷號：${res.mrNumber}，採檢日期：${res.testingDate}`;
                showAlert(detail, "info");
            }

        }).fail(function () {
            showAlert("伺服器錯誤", "danger");
        });
    }

    function refreshDashboard() {
        $.get('/Home/GetDashboard', function (res) {
            $('.card-title').eq(0).text(res.unreadCount);
            $('.card-title').eq(1).text(res.upcomingOverdueCount);
            $('.card-title').eq(2).text(res.overdueCount);
            $('.card-title').eq(3).text(res.criticalOverdueCount);
            $('.card-title').eq(4).text(res.criticalAssessmentCount);
        });
    }


</script>
}