@model ReportDashboardViewModel

<div class="container-fluid">
</div>
<h2>報告統計儀表板</h2>
    <div>
        <div class="row">
            <div class="col-md-3">
            <div class="card unread-card mb-3" role="button" onclick="goToReport('unread')">
                <div class="card-header">未讀報告</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.UnreadCount</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card upcoming-card mb-3" role="button" onclick="goToReport('upcoming')">
                <div class="card-header">將要逾時 (報告未處理 20~30天)</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.UpcomingOverdueCount</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overdue-card mb-3" role="button" onclick="goToReport('overdue')">
                <div class="card-header">已經逾時(報告未處理 30~60天)</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.OverdueCount</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card critical-card mb-3" role="button" onclick="goToReport('critical')">
                <div class="card-header">嚴重逾時(報告未處理 60天以上)</div>
                <div class="card-body">
                    <h5 class="card-title">@Model.CriticalOverdueCount</h5>
                </div>
            </div>
        </div>
    </div>
    <h4>四大類(採檢日期一個月內、未追蹤、未通知)</h4>
    <div>
        <div class="row">
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('prenatalCheckup')">
                    <div class="card-header">產前孕前</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.PrenatalCheckupCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('newborn')">
                    <div class="card-header">新生兒</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.NewbornCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('rareDisease')">
                    <div class="card-header">罕見疾病</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.RareDiseaseCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('cancer')">
                    <div class="card-header">癌症</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.CancerCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('reproductiveMedicine')">
                    <div class="card-header">生殖醫學</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.PreciseMedicationCount</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card unread-card mb-3" role="button" onclick="goToReport('preciseMedication')">
                    <div class="card-header">精準用藥</div>
                    <div class="card-body">
                        <h5 class="card-title">@Model.ReproductiveMedicineCount</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script>
        async function apitest() {
            try {
            const res = await fetch('/home/testAPIAsync', {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' },
            });

            if (!res.ok) {
                const text = await res.text();
                console.error('API error', res.status, text);
                return;
            }

            // 如果後端回傳 JSON
            const data = await res.json();
            console.log('API response JSON:', data);

            // 若後端回傳純文字/非 JSON，改用
            // const text = await res.text();
            // console.log('API response text:', text);

            // 範例：把結果顯示在畫面上
            // document.getElementById('apiResult').innerText = JSON.stringify(data, null, 2);
            } catch (err) {
            console.error('Fetch failed', err);
            }
        }


        function goToReport(type) {
            window.location.href = `/Report/Index?filter=${type}`;
        }

        function showAlert(message, type) {
            const html = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>`;
            $('body').append(html);
            setTimeout(() => $('.alert').alert('close'), 3000);
        }
    </script>
}

<style>
    .card.unread-card {
        background-color: #e0f2ff; /* 淺藍色 */
        color: #004080;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card.unread-card:hover {
        background-color: #d0eaff;
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
        transform: scale(1.03);
    }

    .card.upcoming-card {
        background-color: #e8f5e9; /* 淡綠色 */
        color: #805500;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card.upcoming-card:hover {
        background-color: #ffecb3;
        box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        transform: scale(1.03);
    }

    .card.overdue-card {
        background-color: #fff8e1; /* 淡黃色 */
        color: #1b5e20;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card.overdue-card:hover {
        background-color: #c8e6c9;
        box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
        transform: scale(1.03);
    }

    .card.critical-card {
        background-color: #ffe4e1; /* 淡粉色 */
        color: #800000;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card.critical-card:hover {
        background-color: #ffb6b6;
        box-shadow: 0 4px 12px rgba(255, 0, 0, 0.3);
        transform: scale(1.03);
    }


</style>