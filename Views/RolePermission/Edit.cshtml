@model RolePermission

<form id="editForm">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>角色ID</label>
        <input asp-for="RoleId" class="form-control" />
    </div>
    <div class="form-group">
        <label>權限ID</label>
        <input asp-for="PermissionsId" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">儲存</button>
</form>

<script>
    $('#editForm').submit(function (e) {
        e.preventDefault();
        $.post('/RolePermissions/Edit', $(this).serialize(), function () {
            location.reload();
        });
    });
</script>