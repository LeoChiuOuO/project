@model IEnumerable<RolePermission>

@{
    ViewData["Title"] = "角色權限對應";
}

<h2>角色權限對應</h2>
<a class="btn btn-primary mb-3" href="@Url.Action("Create")">新增對應</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>角色</th>
            <th>權限ID</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var rp in Model)
    {
        <tr>
            <td>@rp.Role?.Name</td>
            <td>@rp.PermissionsId</td>
            <td>
                <a class="btn btn-sm btn-warning" href="@Url.Action("Edit", new { id = rp.Id })">編輯</a>
                <form method="post" action="@Url.Action("Delete", new { id = rp.Id })" style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('確定刪除?')">刪除</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="rpModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">角色權限編輯</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="modalBody">
                <!-- AJAX 載入表單 -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        $('#btnAdd').click(function () {
            $.get('/RolePermissions/Create', function (html) {
                $('#modalBody').html(html);
                $('#rpModal').modal('show');
            });
        });

        $('.btnEdit').click(function () {
            const id = $(this).data('id');
            $.get('/RolePermissions/Edit/' + id, function (html) {
                $('#modalBody').html(html);
                $('#rpModal').modal('show');
            });
        });

        $('.btnDelete').click(function () {
            const id = $(this).data('id');
            if (confirm('確定刪除？')) {
                $.post('/RolePermissions/Delete/' + id, function () {
                    $('tr[data-id="' + id + '"]').remove();
                });
            }
        });
    });
</script>
}
