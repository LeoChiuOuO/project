@model Permission

<form id="editForm">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label>檢視</label>
        <input type="checkbox" asp-for="ReviewPermissions" />
    </div>
    <div class="form-group">
        <label>新增</label>
        <input type="checkbox" asp-for="CreatePermissions" />
    </div>
    <div class="form-group">
        <label>編輯</label>
        <input type="checkbox" asp-for="EditPermissions" />
    </div>
    <div class="form-group">
        <label>刪除</label>
        <input type="checkbox" asp-for="DeletePermissions" />
    </div>
    <button type="submit" class="btn btn-success">儲存</button>
</form>

<script>
    $('#editForm').submit(function (e) {
        e.preventDefault();
        $.post('/Permissions/Edit', $(this).serialize(), function () {
            location.reload();
        });
    });
</script>