@model IEnumerable<Permission>
@{
    ViewData["Title"] = "權限管理";
}

<h2>權限管理</h2>

<!-- 🔹 新增權限表單 -->
<form id="createForm" class="border rounded p-3 mb-4 bg-light" onsubmit="return submitCreateForm(this)">
    <div class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" name="Name" class="form-control" placeholder="權限名稱" required />
        </div>
        @* <div class="col-auto form-check">
            <input type="checkbox" name="ReviewPermissions" class="form-check-input" id="reviewNew" checked />
            <label class="form-check-label" for="reviewNew">檢視</label>
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" name="CreatePermissions" class="form-check-input" id="createNew" />
            <label class="form-check-label" for="createNew">新增</label>
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" name="EditPermissions" class="form-check-input" id="editNew" />
            <label class="form-check-label" for="editNew">編輯</label>
        </div>
        <div class="col-auto form-check">
            <input type="checkbox" name="DeletePermissions" class="form-check-input" id="deleteNew" />
            <label class="form-check-label" for="deleteNew">刪除</label>
        </div> *@
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">新增</button>
        </div>
    </div>
</form>

<!-- 🔹 權限表格 -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>名稱</th>
            <th>檢視</th>
            <th>新增</th>
            <th>編輯</th>
            <th>刪除</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody id="permTableBody">
    @foreach (var p in Model)
    {
        <tr data-id="@p.Id">
            <td>@p.Name</td>
            <td><input type="checkbox" class="perm-toggle" data-id="@p.Id" data-field="ReviewPermissions" @(p.ReviewPermissions ? "checked" : "") disabled /></td>
            <td><input type="checkbox" class="perm-toggle" data-id="@p.Id" data-field="CreatePermissions" @(p.CreatePermissions ? "checked" : "") disabled /></td>
            <td><input type="checkbox" class="perm-toggle" data-id="@p.Id" data-field="EditPermissions" @(p.EditPermissions ? "checked" : "") disabled /></td>
            <td><input type="checkbox" class="perm-toggle" data-id="@p.Id" data-field="DeletePermissions" @(p.DeletePermissions ? "checked" : "") disabled /></td>
            <td>
                <button class="btn btn-sm btn-warning btnSetting" data-id="@p.Id">編輯</button>
                <button class="btn btn-sm btn-danger btnDelete" data-id="@p.Id">刪除</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<!--編輯頁面-->
<div class="modal fade" id="permModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="permEditForm">
        <div class="modal-header">
          <h5 class="modal-title">編輯權限</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="permId" />
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="editReview">
            <label class="form-check-label" for="editReview">檢視</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="editCreate">
            <label class="form-check-label" for="editCreate">新增</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="editEdit">
            <label class="form-check-label" for="editEdit">編輯</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="editDelete">
            <label class="form-check-label" for="editDelete">刪除</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-primary">儲存</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 🔹 Toast 提示 -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
    <div id="toastSuccess" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">操作成功</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 新增權限
    function submitCreateForm(form) {
        $.ajax({
            url: '/Permissions/Create',
            type: 'POST',
            data: $(form).serialize(),
            success: function (res) {
                if (res.success) {
                    showToast("新增成功");
                    location.reload(); // 或改成 append 新列
                } else {
                    alert("新增失敗");
                }
            },
            error: function () {
                alert("伺服器錯誤");
            }
        });
        return false;
    }

    // 編輯權限
    $('.btnSetting').click(function () {
        const id = $(this).data('id');
        const row = $(`tr[data-id="${id}"]`);

        $('#permId').val(id);
        $('#editReview').prop('checked', row.find('input[data-field="ReviewPermissions"]').prop('checked'));
        $('#editCreate').prop('checked', row.find('input[data-field="CreatePermissions"]').prop('checked'));
        $('#editEdit').prop('checked', row.find('input[data-field="EditPermissions"]').prop('checked'));
        $('#editDelete').prop('checked', row.find('input[data-field="DeletePermissions"]').prop('checked'));

        new bootstrap.Modal(document.getElementById('permModal')).show();
    });

    // 儲存編輯權限
    $('#permEditForm').submit(function (e) {
         e.preventDefault();
        const id = $('#permId').val();
        const data = {
            id,
            ReviewPermissions: $('#editReview').is(':checked'),
            CreatePermissions: $('#editCreate').is(':checked'),
            EditPermissions: $('#editEdit').is(':checked'),
            DeletePermissions: $('#editDelete').is(':checked')
        };

        $.ajax({
            url: '/Permissions/UpdateAll',
            type: 'POST',
            data: data,
            success: function (res) {
                if (res.success) {
                    const row = $(`tr[data-id="${id}"]`);
                    row.find('input[data-field="ReviewPermissions"]').prop('checked', data.ReviewPermissions);
                    row.find('input[data-field="CreatePermissions"]').prop('checked', data.CreatePermissions);
                    row.find('input[data-field="EditPermissions"]').prop('checked', data.EditPermissions);
                    row.find('input[data-field="DeletePermissions"]').prop('checked', data.DeletePermissions);

                    showToast("已更新");
                    bootstrap.Modal.getInstance(document.getElementById('permModal')).hide();
                } else {
                    alert("更新失敗：" + res.message);
                }
            },
            error: function () {
                alert("伺服器錯誤");
            }
        });
    });

    // 即時更新 checkbox 權限
    $('.perm-toggle').change(function () {
        const id = $(this).data('id');
        const field = $(this).data('field');
        const value = $(this).is(':checked');

        $.ajax({
            url: '/Permissions/UpdateField',
            type: 'POST',
            data: { id, field, value },
            success: function (res) {
                if (res.success) {
                    showToast("已更新 ");
                } else {
                    alert("更新失敗：" + res.message);
                }
            },
            error: function () {
                alert("伺服器錯誤");
            }
        });
    });

    // 刪除權限
    $('.btnDelete').click(function () {
        const id = $(this).data('id');
        if (confirm('確定刪除？')) {
            $.post('/Permissions/Delete/' + id, function (res) {
                if (res.success) {
                    $('tr[data-id="' + id + '"]').remove();
                    showToast("已刪除");
                } else {
                    alert("刪除失敗");
                }
            });
        }
    });

    // Toast 顯示
    function showToast(message) {
        $('#toastSuccess .toast-body').text(message);
        new bootstrap.Toast(document.getElementById('toastSuccess')).show();
    }
</script>
}